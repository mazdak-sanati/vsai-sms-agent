# Phase 2 SMS agent settings (placeholders only — never commit real values)

# Must match TIMEREPORT_STDIO_TENANT (one tenant per stdio process)
ORGANIZATION_ID=local
TIMEREPORT_STDIO_TENANT=local

# MCP child process
MCP_COMMAND=C:\Users\Mazda\Documents\vectorsynapse-timereport-mcp-server\.venv\Scripts\timereport-mcp.exe --transport stdio
MCP_CWD=C:\Users\Mazda\Documents\vectorsynapse-timereport-mcp-server
TIMEREPORT_CONFIG=C:\Users\Mazda\Documents\time_report_agent\config\local_tenant.toml
TIMEREPORT_DATA_DIR=C:\Users\Mazda\Documents\time_report_agent\data\mcp-send
DATABASE_URL=sqlite:///C:/Users/Mazda/Documents/time_report_agent/data/mcp-send/timereport.db

# Passed through to the MCP child (mock until you intentionally enable live)
SMS_PROVIDER=mock
SMS_LIVE_SEND=false
# ELKS_API_USERNAME=
# ELKS_API_PASSWORD=
# ELKS_FROM=

# Workbook / template
WORKBOOK_ID=
# Optional legacy label only; message body is composed by the agent, not MCP templates.
SMS_TEMPLATE_ID=caller_provided

# Queue and ledger
DEFAULT_CSV_PATH=C:\Users\Mazda\Documents\time_report_agent\queue\list.csv
LEDGER_PATH=C:\Users\Mazda\Documents\time_report_agent\data\send_ledger.db
DEFAULT_PERIOD=2026-11
TIMEZONE=Europe/Stockholm
SEND_WINDOW_START=08:00
SEND_WINDOW_END=22:00
# true = Mon-Fri only; false allows weekends
SEND_WEEKDAYS_ONLY=false

# Local Ollama agent (stays in this process; never forwarded to MCP)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
# Keep false for visible/fast terminal turns (gemma4 thinking can look hung)
OLLAMA_THINK=false

# Diagnostics for SMS delivery issues
MCP_TRACE=true
TIMEREPORT_SMS_TRACE=true

# Do not set LLM_* here — the MCP server rejects those names at startup
