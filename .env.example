# Phase 2 CLI settings (placeholders only — never commit real values)

# Must match TIMEREPORT_STDIO_TENANT (one tenant per stdio process)
ORGANIZATION_ID=tenant-a
TIMEREPORT_STDIO_TENANT=tenant-a

# MCP child process
MCP_COMMAND=timereport-mcp --transport stdio
TIMEREPORT_CONFIG=C:\Users\Mazda\Documents\vectorsynapse-timereport-mcp-server\config\tenants.example.toml
TIMEREPORT_DATA_DIR=C:\Users\Mazda\Documents\time_report_agent\data\mcp
DATABASE_URL=sqlite:///C:/Users/Mazda/Documents/time_report_agent/data/mcp/timereport.db

# Passed through to the MCP child (mock until a live send is explicitly approved)
SMS_PROVIDER=mock
SMS_LIVE_SEND=false
# ELKS_API_USERNAME=
# ELKS_API_PASSWORD=
# ELKS_FROM=

# Workbook / template
# Leave WORKBOOK_ID empty when the tenant has exactly one workbook
WORKBOOK_ID=
SMS_TEMPLATE_ID=timesheet_reminder

# Queue and ledger
DEFAULT_CSV_PATH=C:\Users\Mazda\Documents\time_report_agent\queue\list.csv
LEDGER_PATH=C:\Users\Mazda\Documents\time_report_agent\data\send_ledger.db
TIMEZONE=Europe/Stockholm
SEND_WINDOW_START=08:00
SEND_WINDOW_END=18:00
SEND_WEEKDAYS_ONLY=true

# Do not set LLM_* here — the MCP server rejects those names at startup
